rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function accountAccessPath() {
      return /databases/$(database)/documents/accountAccess/$(request.auth.uid);
    }

    function isCanonicalActiveAccess(data) {
      return data.keys().hasOnly(['status', 'confirmedViolationCount', 'updatedAt'])
        && data.keys().hasAll(['status', 'confirmedViolationCount', 'updatedAt'])
        && data.status == 'active'
        && data.confirmedViolationCount is int
        && data.confirmedViolationCount >= 0
        && data.updatedAt is timestamp;
    }

    function isActiveAccount() {
      return isAuthenticated()
        && (!exists(accountAccessPath())
          || isCanonicalActiveAccess(get(accountAccessPath()).data));
    }

    function isPositiveNumber(value) {
      return (value is int || value is float) && value > 0;
    }

    function isNonNegativeNumber(value) {
      return (value is int || value is float) && value >= 0;
    }

    function hasValidListingImages(data) {
      return data.imageUrls is list
        && data.imageUrls.size() >= 1
        && data.imageUrls.size() <= 3
        && data.imageUrls[0] is string
        && (data.imageUrls.size() < 2 || data.imageUrls[1] is string)
        && (data.imageUrls.size() < 3 || data.imageUrls[2] is string);
    }

    function isValidNewListing(data) {
      return data.keys().hasOnly([
          'sellerId', 'cardId', 'cardType', 'cardName', 'characterName', 'rarity',
          'imageUrls', 'listingPrice', 'originalQuantity', 'remainingQuantity',
          'hasSleeve', 'sleeveFee', 'supportsMyShip', 'myShipFee', 'note',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'sellerId', 'cardId', 'cardType', 'cardName', 'rarity', 'imageUrls',
          'listingPrice', 'originalQuantity', 'remainingQuantity', 'hasSleeve',
          'supportsMyShip', 'status', 'createdAt', 'updatedAt'
        ])
        && data.sellerId is string
        && data.sellerId == request.auth.uid
        && data.cardId is string
        && data.cardId.matches('^(\\d{4}|P\\d{3})$')
        && data.cardType in ['character', 'event', 'case', 'partner']
        && data.cardName is string
        && data.cardName.size() >= 1
        && data.cardName.size() <= 200
        && data.rarity is string
        && data.rarity.size() >= 1
        && data.rarity.size() <= 100
        && ((data.cardType == 'character'
            && data.keys().hasAll(['characterName'])
            && data.characterName is string
            && data.characterName == data.cardName)
          || (data.cardType != 'character' && !('characterName' in data)))
        && hasValidListingImages(data)
        && isPositiveNumber(data.listingPrice)
        && data.originalQuantity is int
        && data.originalQuantity > 0
        && data.remainingQuantity is int
        && data.remainingQuantity == data.originalQuantity
        && data.hasSleeve is bool
        && (!('sleeveFee' in data)
          || (data.hasSleeve && isNonNegativeNumber(data.sleeveFee)))
        && data.supportsMyShip is bool
        && (!('myShipFee' in data)
          || (data.supportsMyShip && isNonNegativeNumber(data.myShipFee)))
        && (!('note' in data) || (data.note is string && data.note.size() <= 2000))
        && data.status == 'active'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt == data.updatedAt;
    }

    match /cards/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /cardMasterArchives/{id} {
      allow read, write: if false;
    }

    match /cardMasterAuditLogs/{id} {
      allow read, write: if false;
    }

    match /accountAccess/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    match /sellerProfiles/{uid} {
      allow read: if resource.data.keys().hasOnly(['displayName', 'createdAt', 'updatedAt'])
        && resource.data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && resource.data.displayName is string
        && resource.data.displayName.size() >= 1
        && resource.data.displayName.size() <= 80
        && resource.data.createdAt is timestamp
        && resource.data.updatedAt is timestamp;
      allow write: if false;
    }

    match /sellerContacts/{uid} {
      allow read, write: if false;
    }
    match /sellerContactAccessLogs/{id} {
      allow read, write: if false;
    }
    match /sellerContactRequesterLimits/{id} {
      allow read, write: if false;
    }
    match /sellerContactSellerLimits/{id} {
      allow read, write: if false;
    }

    match /moderationReports/{id} {
      allow read, write: if false;
    }
    match /moderationReportRequestKeys/{id} {
      allow read, write: if false;
    }
    match /moderationReportLimits/{id} {
      allow read, write: if false;
    }

    match /listings/{id} {
      allow read: if resource.data.status == 'active'
        || (isAuthenticated() && request.auth.uid == resource.data.sellerId);
      allow create: if isActiveAccount()
        && isValidNewListing(request.resource.data);
      allow update, delete: if false;
    }

    match /sales/{id} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.sellerId;
      allow create, update, delete: if false;
    }

    function isValidNotificationSubscription() {
      // Rules cannot iterate list entries within the 1,000-expression limit.
      // Browser converters validate exact entries; digest parsing rejects the whole document
      // when any nested seller entry is malformed.
      return request.resource.data.keys().hasOnly([
          'cardNames', 'sellerSubscriptions', 'emailDailyEnabled', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'cardNames', 'sellerSubscriptions', 'emailDailyEnabled', 'updatedAt'
        ])
        && request.resource.data.cardNames is list
        && request.resource.data.cardNames.size() <= 100
        && request.resource.data.cardNames.toSet().size() == request.resource.data.cardNames.size()
        && request.resource.data.sellerSubscriptions is list
        && request.resource.data.sellerSubscriptions.size() <= 100
        && request.resource.data.emailDailyEnabled is bool
        && request.resource.data.updatedAt is timestamp;
    }

    match /notificationSubscriptions/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow delete: if isActiveAccount() && request.auth.uid == uid;
      allow create, update: if isActiveAccount()
        && request.auth.uid == uid
        && isValidNotificationSubscription();
    }

    match /notificationDeliveryState/{id} {
      allow read, write: if false;
    }
    match /notificationDigestRuns/{id} {
      allow read, write: if false;
    }
    match /notificationDigestRuntime/{id} {
      allow read, write: if false;
    }
    match /listingEvents/{id} {
      allow read, write: if false;
    }
  }
}
