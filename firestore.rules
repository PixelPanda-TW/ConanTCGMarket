rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /cards/{id} { allow read: if true; allow write: if false; }
    match /sellerProfiles/{uid} { allow read: if true; allow write: if request.auth != null && request.auth.uid == uid; }
    match /listings/{id} { allow read: if resource.data.status == 'active' || (request.auth != null && request.auth.uid == resource.data.sellerId); allow create: if request.auth != null && request.auth.uid == request.resource.data.sellerId; allow update, delete: if request.auth != null && request.auth.uid == resource.data.sellerId; }
    match /sales/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.sellerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if false;
    }
    function isValidCardName(cardName) {
      return cardName is string
        && cardName.size() > 0
        && cardName.size() <= 100
        && cardName.matches('^\\S(.*\\S)?$');
    }
    function areValidCardNames(cardNames) {
      return cardNames is list
        && cardNames.size() <= 100
        && (cardNames.size() <= 0 || isValidCardName(cardNames[0]))
        && (cardNames.size() <= 1 || isValidCardName(cardNames[1]))
        && (cardNames.size() <= 2 || isValidCardName(cardNames[2]))
        && (cardNames.size() <= 3 || isValidCardName(cardNames[3]))
        && (cardNames.size() <= 4 || isValidCardName(cardNames[4]))
        && (cardNames.size() <= 5 || isValidCardName(cardNames[5]))
        && (cardNames.size() <= 6 || isValidCardName(cardNames[6]))
        && (cardNames.size() <= 7 || isValidCardName(cardNames[7]))
        && (cardNames.size() <= 8 || isValidCardName(cardNames[8]))
        && (cardNames.size() <= 9 || isValidCardName(cardNames[9]))
        && (cardNames.size() <= 10 || isValidCardName(cardNames[10]))
        && (cardNames.size() <= 11 || isValidCardName(cardNames[11]))
        && (cardNames.size() <= 12 || isValidCardName(cardNames[12]))
        && (cardNames.size() <= 13 || isValidCardName(cardNames[13]))
        && (cardNames.size() <= 14 || isValidCardName(cardNames[14]))
        && (cardNames.size() <= 15 || isValidCardName(cardNames[15]))
        && (cardNames.size() <= 16 || isValidCardName(cardNames[16]))
        && (cardNames.size() <= 17 || isValidCardName(cardNames[17]))
        && (cardNames.size() <= 18 || isValidCardName(cardNames[18]))
        && (cardNames.size() <= 19 || isValidCardName(cardNames[19]))
        && (cardNames.size() <= 20 || isValidCardName(cardNames[20]))
        && (cardNames.size() <= 21 || isValidCardName(cardNames[21]))
        && (cardNames.size() <= 22 || isValidCardName(cardNames[22]))
        && (cardNames.size() <= 23 || isValidCardName(cardNames[23]))
        && (cardNames.size() <= 24 || isValidCardName(cardNames[24]))
        && (cardNames.size() <= 25 || isValidCardName(cardNames[25]))
        && (cardNames.size() <= 26 || isValidCardName(cardNames[26]))
        && (cardNames.size() <= 27 || isValidCardName(cardNames[27]))
        && (cardNames.size() <= 28 || isValidCardName(cardNames[28]))
        && (cardNames.size() <= 29 || isValidCardName(cardNames[29]))
        && (cardNames.size() <= 30 || isValidCardName(cardNames[30]))
        && (cardNames.size() <= 31 || isValidCardName(cardNames[31]))
        && (cardNames.size() <= 32 || isValidCardName(cardNames[32]))
        && (cardNames.size() <= 33 || isValidCardName(cardNames[33]))
        && (cardNames.size() <= 34 || isValidCardName(cardNames[34]))
        && (cardNames.size() <= 35 || isValidCardName(cardNames[35]))
        && (cardNames.size() <= 36 || isValidCardName(cardNames[36]))
        && (cardNames.size() <= 37 || isValidCardName(cardNames[37]))
        && (cardNames.size() <= 38 || isValidCardName(cardNames[38]))
        && (cardNames.size() <= 39 || isValidCardName(cardNames[39]))
        && (cardNames.size() <= 40 || isValidCardName(cardNames[40]))
        && (cardNames.size() <= 41 || isValidCardName(cardNames[41]))
        && (cardNames.size() <= 42 || isValidCardName(cardNames[42]))
        && (cardNames.size() <= 43 || isValidCardName(cardNames[43]))
        && (cardNames.size() <= 44 || isValidCardName(cardNames[44]))
        && (cardNames.size() <= 45 || isValidCardName(cardNames[45]))
        && (cardNames.size() <= 46 || isValidCardName(cardNames[46]))
        && (cardNames.size() <= 47 || isValidCardName(cardNames[47]))
        && (cardNames.size() <= 48 || isValidCardName(cardNames[48]))
        && (cardNames.size() <= 49 || isValidCardName(cardNames[49]))
        && (cardNames.size() <= 50 || isValidCardName(cardNames[50]))
        && (cardNames.size() <= 51 || isValidCardName(cardNames[51]))
        && (cardNames.size() <= 52 || isValidCardName(cardNames[52]))
        && (cardNames.size() <= 53 || isValidCardName(cardNames[53]))
        && (cardNames.size() <= 54 || isValidCardName(cardNames[54]))
        && (cardNames.size() <= 55 || isValidCardName(cardNames[55]))
        && (cardNames.size() <= 56 || isValidCardName(cardNames[56]))
        && (cardNames.size() <= 57 || isValidCardName(cardNames[57]))
        && (cardNames.size() <= 58 || isValidCardName(cardNames[58]))
        && (cardNames.size() <= 59 || isValidCardName(cardNames[59]))
        && (cardNames.size() <= 60 || isValidCardName(cardNames[60]))
        && (cardNames.size() <= 61 || isValidCardName(cardNames[61]))
        && (cardNames.size() <= 62 || isValidCardName(cardNames[62]))
        && (cardNames.size() <= 63 || isValidCardName(cardNames[63]))
        && (cardNames.size() <= 64 || isValidCardName(cardNames[64]))
        && (cardNames.size() <= 65 || isValidCardName(cardNames[65]))
        && (cardNames.size() <= 66 || isValidCardName(cardNames[66]))
        && (cardNames.size() <= 67 || isValidCardName(cardNames[67]))
        && (cardNames.size() <= 68 || isValidCardName(cardNames[68]))
        && (cardNames.size() <= 69 || isValidCardName(cardNames[69]))
        && (cardNames.size() <= 70 || isValidCardName(cardNames[70]))
        && (cardNames.size() <= 71 || isValidCardName(cardNames[71]))
        && (cardNames.size() <= 72 || isValidCardName(cardNames[72]))
        && (cardNames.size() <= 73 || isValidCardName(cardNames[73]))
        && (cardNames.size() <= 74 || isValidCardName(cardNames[74]))
        && (cardNames.size() <= 75 || isValidCardName(cardNames[75]))
        && (cardNames.size() <= 76 || isValidCardName(cardNames[76]))
        && (cardNames.size() <= 77 || isValidCardName(cardNames[77]))
        && (cardNames.size() <= 78 || isValidCardName(cardNames[78]))
        && (cardNames.size() <= 79 || isValidCardName(cardNames[79]))
        && (cardNames.size() <= 80 || isValidCardName(cardNames[80]))
        && (cardNames.size() <= 81 || isValidCardName(cardNames[81]))
        && (cardNames.size() <= 82 || isValidCardName(cardNames[82]))
        && (cardNames.size() <= 83 || isValidCardName(cardNames[83]))
        && (cardNames.size() <= 84 || isValidCardName(cardNames[84]))
        && (cardNames.size() <= 85 || isValidCardName(cardNames[85]))
        && (cardNames.size() <= 86 || isValidCardName(cardNames[86]))
        && (cardNames.size() <= 87 || isValidCardName(cardNames[87]))
        && (cardNames.size() <= 88 || isValidCardName(cardNames[88]))
        && (cardNames.size() <= 89 || isValidCardName(cardNames[89]))
        && (cardNames.size() <= 90 || isValidCardName(cardNames[90]))
        && (cardNames.size() <= 91 || isValidCardName(cardNames[91]))
        && (cardNames.size() <= 92 || isValidCardName(cardNames[92]))
        && (cardNames.size() <= 93 || isValidCardName(cardNames[93]))
        && (cardNames.size() <= 94 || isValidCardName(cardNames[94]))
        && (cardNames.size() <= 95 || isValidCardName(cardNames[95]))
        && (cardNames.size() <= 96 || isValidCardName(cardNames[96]))
        && (cardNames.size() <= 97 || isValidCardName(cardNames[97]))
        && (cardNames.size() <= 98 || isValidCardName(cardNames[98]))
        && (cardNames.size() <= 99 || isValidCardName(cardNames[99]));
    }
    function isValidNotificationSubscription() {
      return request.resource.data.keys().hasOnly(['cardNames', 'emailDailyEnabled', 'updatedAt'])
        && request.resource.data.keys().hasAll(['cardNames', 'emailDailyEnabled', 'updatedAt'])
        && areValidCardNames(request.resource.data.cardNames)
        && request.resource.data.cardNames.toSet().size() == request.resource.data.cardNames.size()
        && request.resource.data.emailDailyEnabled is bool
        && request.resource.data.updatedAt is timestamp;
    }
    match /notificationSubscriptions/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && isValidNotificationSubscription();
    }
    match /notificationDeliveryState/{id} { allow read, write: if false; }
    match /notificationDigestRuns/{id} { allow read, write: if false; }
    match /notificationDigestRuntime/{id} { allow read, write: if false; }
    match /listingEvents/{id} { allow read, write: if false; }
  }
}
