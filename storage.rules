rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function accountAccessPath() {
      return /databases/(default)/documents/accountAccess/$(request.auth.uid);
    }

    function isCanonicalActiveAccess(data) {
      return data.keys().hasOnly(['status', 'confirmedViolationCount', 'updatedAt'])
        && data.keys().hasAll(['status', 'confirmedViolationCount', 'updatedAt'])
        && data.status == 'active'
        && data.confirmedViolationCount is int
        && data.confirmedViolationCount >= 0
        && data.updatedAt is timestamp;
    }

    function isActiveAccount() {
      return request.auth != null
        && (!firestore.exists(accountAccessPath())
          || isCanonicalActiveAccess(firestore.get(accountAccessPath()).data));
    }

    match /listings/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isActiveAccount() && request.auth.uid == uid;
    }

    function reportPath(reportId) {
      return /databases/(default)/documents/moderationReports/$(reportId);
    }

    function isOwnedActiveDraft(uid, reportId) {
      return firestore.exists(reportPath(reportId))
        && firestore.get(reportPath(reportId)).data.keys().hasOnly([
          'status', 'requestKey', 'reporterId', 'targetSellerId',
          'listingSnapshot', 'createdAt', 'expiresAt'
        ])
        && firestore.get(reportPath(reportId)).data.keys().hasAll([
          'status', 'requestKey', 'reporterId', 'targetSellerId',
          'listingSnapshot', 'createdAt', 'expiresAt'
        ])
        && firestore.get(reportPath(reportId)).data.status == 'draft'
        && firestore.get(reportPath(reportId)).data.reporterId == uid
        && firestore.get(reportPath(reportId)).data.expiresAt is timestamp
        && firestore.get(reportPath(reportId)).data.expiresAt > request.time;
    }

    function canWriteReportEvidence(uid, reportId, slot) {
      return isActiveAccount()
        && request.auth.uid == uid
        && slot.matches('^[0-2]$')
        && isOwnedActiveDraft(uid, reportId);
    }

    match /reportEvidence/{uid}/{reportId}/{slot} {
      allow read: if false;
      allow create, update: if canWriteReportEvidence(uid, reportId, slot)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if canWriteReportEvidence(uid, reportId, slot);
    }

    function appealAccountPath(uid) {
      return /databases/(default)/documents/accountAccess/$(uid);
    }

    function appealOperationPath(actionId) {
      return /databases/(default)/documents/accountModerationOperations/$(actionId);
    }

    function isExactSuspendedAppealOwner(uid, actionId) {
      return request.auth != null
        && request.auth.uid == uid
        && firestore.exists(appealAccountPath(uid))
        && firestore.get(appealAccountPath(uid)).data.keys().hasOnly([
          'status', 'confirmedViolationCount', 'suspensionReason', 'suspendedAt',
          'suspendedBy', 'suspensionActionId', 'updatedAt'
        ])
        && firestore.get(appealAccountPath(uid)).data.keys().hasAll([
          'status', 'confirmedViolationCount', 'suspensionReason', 'suspendedAt',
          'suspendedBy', 'suspensionActionId', 'updatedAt'
        ])
        && firestore.get(appealAccountPath(uid)).data.status == 'suspended'
        && firestore.get(appealAccountPath(uid)).data.suspensionActionId == actionId
        && firestore.exists(appealOperationPath(actionId))
        && firestore.get(appealOperationPath(actionId)).data.status == 'suspended'
        && firestore.get(appealOperationPath(actionId)).data.actionId == actionId
        && firestore.get(appealOperationPath(actionId)).data.targetUid == uid;
    }

    function canWriteAppealDraft(uid, actionId, draftId, slot) {
      return actionId.matches('^[0-9a-f]{64}$')
        && draftId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && slot.matches('^[0-2]$')
        && isExactSuspendedAppealOwner(uid, actionId);
    }

    match /account-appeal-evidence/{uid}/{actionId}/{draftId}/{slot} {
      allow read: if false;
      allow create, update: if canWriteAppealDraft(uid, actionId, draftId, slot)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if canWriteAppealDraft(uid, actionId, draftId, slot);
    }
  }
}
